# CRITICAL FOR PRODUCTION: must be "true" in your real deployment.
# Defaults to false for early local development, before login existed.
# A real login page now exists (src/app/(auth)/login) -- leaving this
# false in production means every /owner/* and /candidate/* route is
# reachable with ZERO authentication required. Set to "true" in
# Vercel's project environment variables before going live.
AUTH_ENFORCEMENT_ENABLED=false

# Copy this file to .env.local and fill in real values.
# Get these from your Supabase project settings (Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://ewduooooixondbiadlww.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV3ZHVvb29vaXhvbmRiaWFkbHd3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIzNzM4NjYsImV4cCI6MjA5Nzk0OTg2Nn0.GwQTEEtP42W196b9HKBCwL-6bpMFPUWE_BaWud5PMYs

# Server-only. NEVER expose this to the client or commit it.
# Used only in src/lib/supabase/server.ts (createServiceClient) for
# trusted server operations like the payment webhook handler.
SUPABASE_SERVICE_ROLE_KEY=

# Payment provider. Gumroad is primary (Dodo Payments couldn't verify
# accounts in Nigeria at all; Paddle rejected the domain's category on
# review), Lemon Squeezy is kept ready as a fallback -- see
# src/lib/payments/config.ts. Flip this one variable to switch which
# provider is actually live; no code changes needed either way.
PAYMENT_PROVIDER=gumroad
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Gumroad (active provider) ---
# See GUMROAD_SETUP.md at the repo root for the full one-time setup
# this depends on (creating the access token, the Standard product,
# and registering the ping/resource_subscriptions).
GUMROAD_ACCESS_TOKEN=
GUMROAD_SELLER_SUBDOMAIN=
GUMROAD_STANDARD_PERMALINK=

# --- Lemon Squeezy (fallback provider, only used if PAYMENT_PROVIDER
# above is set to "lemonsqueezy") ---
# See GUMROAD_SETUP.md for the matching Lemon Squeezy setup steps.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_STANDARD_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# AI provider. Default is GitHub Models (free, Azure-hosted GPT) for
# early development -- see https://docs.github.com/en/github-models
# Get a free token from your GitHub account settings -> Developer settings
# -> Personal access tokens (needs `models: read` permission), or from
# the "Get API key" button on any model page at github.com/marketplace/models
#
# Switch AI_PROVIDER to "anthropic" / "openai" / "gemini" any time --
# no other code changes needed, see src/lib/ai/provider.ts, this is the
# only file that reads these.
#
# Every provider below accepts either a single key, or a comma-separated
# list in the *_API_KEYS (plural) variant for automatic failover -- if
# one key comes back rate-limited or unauthorized, the next is tried
# automatically before giving up.
AI_PROVIDER=github_models

GITHUB_MODELS_TOKEN=
GITHUB_MODELS_TOKENS=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_API_KEYS=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.0-flash

# Serper.dev (Google Maps rating lookup for practice profiles).
# Used instead of the official Google Places API, which requires billing
# to be enabled on the Google Cloud project -- Serper wraps Google
# Search/Maps results without that requirement. Free tier is 2,500
# credits/account. To use multiple free accounts' keys with automatic
# fallback (if one is rate-limited or exhausted, the next is tried),
# comma-separate them in SERPER_API_KEYS instead. Get a key at
# https://serper.dev
SERPER_API_KEY=
SERPER_API_KEYS=

# Cloudflare Turnstile (CAPTCHA on public review submission). Free,
# no billing required. Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile -- the site key
# is public (safe in client-side code), the secret key must stay
# server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Where support-ticket escalations from the AI help chat get emailed
# (src/app/api/help-chat/escalate) -- there's no admin dashboard yet,
# so this is what makes an escalation actually actionable.
SUPPORT_EMAIL=

# Twilio (add in Phase 2 -- SMS screening invites and notification preferences)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend (real email sending -- new messages, match alerts, interview
# invites). Get a free key at resend.com. Until you verify a domain
# there, Resend's sandbox sender only delivers to your own account
# email -- fine for local testing, not for real users.
RESEND_API_KEY=
EMAIL_FROM="Hdenta <notifications@yourdomain.com>"

# Secures the scheduled weekly Google rating re-sync
# (/api/cron/sync-google-ratings, see vercel.json). Vercel automatically
# sends this as a Bearer token when it triggers the cron job -- generate
# any random string (e.g. `openssl rand -hex 32`) and set the same value
# here and in your Vercel project's environment variables.
CRON_SECRET=
